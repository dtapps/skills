{
  "name": "@tencentnews/cli",
  "version": "1.0.0",
  "description": "腾讯新闻 Skill CLI 管理工具 - 下载、安装、升级和运行 CLI 程序",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tencent-news-cli": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "postinstall": "node dist/postinstall.js",
    "test": "tsx test/index.ts",
    "prepublishOnly": "npm run build",
    "publish:test": "node scripts/publish-test.js",
    "publish:npm": "node scripts/publish.js"
  },
  "keywords": [
    "tencent-news",
    "cli",
    "skill"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
